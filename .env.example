# Farglow settings. ./install.sh writes the real .env (mode 600) from your answers and
# generates every secret. This file documents the keys; it is never read by anything.
# Values are single-quoted in .env so a $ in a password is never expanded.

# --- Server ---------------------------------------------------------------------
FARGLOW_DOMAIN='play.example.org'        # host name players use
FARGLOW_PUBLIC_URL='https://play.example.org'   # derived by install.sh (scheme + port)
FARGLOW_HTTP_PORT='80'
FARGLOW_HTTPS_PORT='443'
FARGLOW_TLS_DIR='./tls'                   # fullchain.pem + privkey.pem here = HTTPS
FARGLOW_ADMIN_EMAIL='host@example.org'    # test email; first host admin
# FARGLOW_BIND='0.0.0.0'                  # address nginx listens on (127.0.0.1 behind a proxy)

# --- Images ---------------------------------------------------------------------
FARGLOW_IMAGE_SOURCE='ghcr'               # ghcr | local (./build.sh --local)
FARGLOW_REGISTRY='ghcr.io/ennissh'
FARGLOW_IMAGE_TAG='0.0.0'                 # a release, or 'local'

# --- AI (T0 = no AI; every feature works without it) ----------------------------
FARGLOW_AI_TIER='T0'                      # T0 | T1 | T2 | T3 | T4
FARGLOW_LLM_ENDPOINT=''                   # T1/T2: http://mac-studio:11434 · T3: https://api.openai.com/v1
FARGLOW_LLM_MODEL=''
FARGLOW_LLM_API_KEY=''                    # T3 only (secret)
# FARGLOW_LLM_TIMEOUT='30'

# --- Mail (blank SMTP_HOST = mail off) -----------------------------------------
SMTP_HOST=''
SMTP_PORT='587'
SMTP_SECURITY='starttls'                  # starttls | ssl | none (LAN relays only)
SMTP_USER=''
SMTP_PASSWORD=''                          # secret
SMTP_FROM='Farglow <dispatch@play.example.org>'

# --- Engine ---------------------------------------------------------------------
FARGLOW_DEBUG='false'                     # true = ticks every 5 minutes, debug logging
# FARGLOW_TICK_SECONDS=''                 # override the tick length (tests only)
# FARGLOW_RESTORE_POINTS_KEEP='72'
# FARGLOW_BACKUP_HOUR='03'                # nightly pg_dump hour (UTC) in the backup service
# FARGLOW_BACKUP_KEEP='7'
# FARGLOW_WEB_WORKERS='2'
# FARGLOW_LOG_LEVEL='INFO'

# --- Network --------------------------------------------------------------------
FARGLOW_DNS_1='192.168.1.1'               # host DNS (detected), so LAN/Tailscale names resolve
FARGLOW_DNS_2='1.1.1.1'

# --- Generated by install.sh: never share, never change on a running server ----
# POSTGRES_PASSWORD, FARGLOW_SECRET_KEY and FARGLOW_LINK_SIGNING_KEY are random hex.
# The galaxy seed is the galaxy's identity: keep it forever.
POSTGRES_PASSWORD=
FARGLOW_SECRET_KEY=
FARGLOW_LINK_SIGNING_KEY=
FARGLOW_GALAXY_SEED=
