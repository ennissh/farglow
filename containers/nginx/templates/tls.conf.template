# Rendered by the nginx entrypoint (envsubst on FARGLOW_* variables only).
server_tokens off;
client_max_body_size 2m;

upstream farglow_api {
    server api:8000;
    keepalive 16;
}

server {
    listen 8080 default_server;
    server_name ${FARGLOW_DOMAIN};
    location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name ${FARGLOW_DOMAIN};

    ssl_certificate     /etc/farglow/tls/fullchain.pem;
    ssl_certificate_key /etc/farglow/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:farglow:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }

    location /static/ {
        alias /usr/share/nginx/farglow/static/;
        expires 7d;
        add_header Cache-Control "public" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        proxy_pass http://farglow_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }
}
